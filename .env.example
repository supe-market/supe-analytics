NODE_ENV=development
HOST=0.0.0.0
PORT=3010
COOKIE_SECRET=change-me
ALLOWED_ORIGINS=.*

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supe_analytics
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=supe_analytics
DB_SSL=false

UMS_AUTH_URL=http://localhost:3001/api/v1
UMS_AUTH_PARAM=

S3_REGION=ap-south-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

ASK_REDIS_URL=
ASK_REDIS_HOST=
ASK_REDIS_PORT=6379
ASK_REDIS_DB=0
ASK_REDIS_USERNAME=
ASK_REDIS_PASSWORD=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
ASK_GRAPH_CACHE_TTL_SECONDS=43200

DEFAULT_WORKSPACE_ID=default-workspace
DEFAULT_WORKSPACE_NAME=Default Workspace
IMPORT_MAX_FILE_MB=25
IMPORT_WORKER_ENABLED=true
IMPORT_POLL_INTERVAL_MS=5000
IMPORT_WORKER_CONCURRENCY=1
