NODE_ENV=development
HOST=0.0.0.0
PORT=3010
COOKIE_SECRET=change-me
ALLOWED_ORIGINS=.*

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=supe_analytics
DB_SSL=false

UMS_AUTH_URL=http://localhost:3201/api/v1
UMS_AUTH_PARAM=

S3_REGION=ap-south-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

DEFAULT_WORKSPACE_ID=default-workspace
DEFAULT_WORKSPACE_NAME=Default Workspace
IMPORT_MAX_FILE_MB=25
IMPORT_WORKER_ENABLED=true
IMPORT_POLL_INTERVAL_MS=5000
IMPORT_WORKER_CONCURRENCY=1
