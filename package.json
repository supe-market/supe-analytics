{
  "name": "supe-analytics",
  "version": "1.0.0",
  "description": "Supe supe analytics backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "start": "node dist/server.js",
    "typeorm": "tsx ./node_modules/typeorm/cli.js -d src/db/data-source.ts",
    "typeorm:migrate": "npm run typeorm -- migration:run",
    "typeorm:revert": "npm run typeorm -- migration:revert"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supe-market/supe-analytics.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/supe-market/supe-analytics/issues"
  },
  "homepage": "https://github.com/supe-market/supe-analytics#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1009.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.4.0",
    "axios": "^1.13.6",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.2",
    "pg": "^8.20.0",
    "pg-copy-streams": "^7.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
